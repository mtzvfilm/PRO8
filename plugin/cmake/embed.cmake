# Generates pro8_embedded.cpp (Windows): core/ui.html and the seed banks (plugin/resources/banks/A..Z.syx) as byte arrays.
#   cmake -DUI=<ui.html> -DBANKS=<banks dir> -DOUT=<pro8_embedded.cpp> -P embed.cmake
function(to_array file var out)
    file(READ "${file}" hex HEX)
    string(LENGTH "${hex}" n)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," arr "${hex}")
    string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n" arr "${arr}")
    math(EXPR bytes "${n} / 2")
    set(${out} "static const unsigned char ${var}[] = {\n${arr}0};\nstatic const size_t ${var}_N = ${bytes};\n" PARENT_SCOPE)
endfunction()

to_array("${UI}" UI_HTML src)
set(body "// generated by plugin/cmake/embed.cmake - do not edit\n#include \"pro8_embedded.h\"\n#include <cstddef>\n\n${src}\n")
set(cases "")
foreach(i RANGE 0 25)
    math(EXPR code "65 + ${i}")
    string(ASCII ${code} letter)
    if(EXISTS "${BANKS}/${letter}.syx")
        to_array("${BANKS}/${letter}.syx" BANK_${letter} src)
        string(APPEND body "${src}\n")
        string(APPEND cases "    case ${i}: data.assign(BANK_${letter}, BANK_${letter} + BANK_${letter}_N); return true;\n")
    endif()
endforeach()
string(APPEND body "const std::string& pro8_embedded_ui_html() { static const std::string s((const char*)UI_HTML, UI_HTML_N); return s; }\n")
string(APPEND body "bool pro8_embedded_bank(int bank, std::vector<uint8_t>& data) {\n    switch (bank) {\n${cases}    default: return false;\n    }\n}\n")
file(WRITE "${OUT}.tmp" "${body}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
